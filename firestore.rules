rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------
    // HELPER FUNCTIONS
    // ------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isCurrentUser(userId) {
      return isSignedIn()
          && request.auth.uid == userId;
    }

    function isVeterinarian() {
      return isSignedIn()
          && get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.role == 'veterinarian';
    }

    function isStaff() {
      return isSignedIn()
          && get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.role == 'staff';
    }

    // ------------------------------------------------------------
    // USERS
    // ------------------------------------------------------------

    match /users/{userId} {

      // A signed-in user can read only their own profile.
      allow read: if isCurrentUser(userId);

      // User profiles cannot be modified from the application.
      // They are managed by the Firebase/backend administrator.
      allow write: if false;
    }

    // ------------------------------------------------------------
    // PETS
    // ------------------------------------------------------------

    match /pets/{petId} {

      // Veterinarians and clinic staff can view pets.
      allow read: if isVeterinarian() || isStaff();

      // Both roles can create/update basic pet information.
      allow create, update: if isVeterinarian() || isStaff();

      // Pet deletion is disabled to protect medical history.
      allow delete: if false;
    }

    // ------------------------------------------------------------
    // TREATMENTS
    // ------------------------------------------------------------

    match /treatments/{treatmentId} {

      // Veterinarians and staff can view medical history.
      allow read: if isVeterinarian() || isStaff();

      // Only veterinarians can create or modify treatments.
      allow create, update: if isVeterinarian();

      // Only veterinarians can delete a treatment.
      allow delete: if isVeterinarian();
    }

    // ------------------------------------------------------------
    // VACCINATIONS
    // ------------------------------------------------------------

    match /vaccinations/{vaccinationId} {

      // Veterinarians and staff can view vaccination history.
      allow read: if isVeterinarian() || isStaff();

      // Only veterinarians can create or modify vaccinations.
      allow create, update: if isVeterinarian();

      // Only veterinarians can delete vaccinations.
      allow delete: if isVeterinarian();
    }

    // ------------------------------------------------------------
    // FOLLOW-UPS
    // ------------------------------------------------------------

    match /followUps/{followUpId} {

      // Veterinarians and staff can view follow-ups.
      allow read: if isVeterinarian() || isStaff();

      // Only veterinarians create or modify follow-ups.
      allow create, update: if isVeterinarian();

      // Only veterinarians can delete follow-ups.
      allow delete: if isVeterinarian();
    }

    // ------------------------------------------------------------
    // APPOINTMENTS
    // ------------------------------------------------------------

    match /appointments/{appointmentId} {

      // Both roles can view appointments.
      allow read: if isVeterinarian() || isStaff();

      // Clinic staff schedules/updates appointments.
      allow create, update: if isStaff();

      // Staff can delete an appointment if required.
      allow delete: if isStaff();
    }

    // ------------------------------------------------------------
    // CLINICS
    // ------------------------------------------------------------

    match /clinics/{branchId} {

      // Both roles can view clinic/branch information.
      allow read: if isVeterinarian() || isStaff();

      // Clinic information is administrative data.
      // Only veterinarians can create/update it in the application.
      allow create, update: if isVeterinarian();

      // Prevent accidental deletion of a branch.
      allow delete: if false;
    }
  }
}
