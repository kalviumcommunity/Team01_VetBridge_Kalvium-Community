rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isVeterinarian() {
      return isSignedIn()
          && get(
               /databases/$(database)/documents/users/$(request.auth.uid)
             ).data.role == 'veterinarian';
    }

    function isStaff() {
      return isSignedIn()
          && get(
               /databases/$(database)/documents/users/$(request.auth.uid)
             ).data.role == 'staff';
    }

    // ------------------------------------------------------------
    // USERS
    // ------------------------------------------------------------

    match /users/{userId} {
      allow read: if isSignedIn()
                  && request.auth.uid == userId;

      allow write: if false;
    }

    // ------------------------------------------------------------
    // PETS
    // Veterinarians and clinic staff can view/create/update pets.
    // Deleting a central pet record is not allowed.
    // ------------------------------------------------------------

    match /pets/{petId} {
      allow read: if isVeterinarian() || isStaff();

      allow create, update: if isVeterinarian() || isStaff();

      allow delete: if false;
    }

    // ------------------------------------------------------------
    // TREATMENTS
    // Veterinarians only can create/update/delete.
    // Both roles can view.
    // ------------------------------------------------------------

    match /treatments/{treatmentId} {
      allow read: if isVeterinarian() || isStaff();

      allow create, update, delete: if isVeterinarian();
    }

    // ------------------------------------------------------------
    // VACCINATIONS
    // Veterinarians only can create/update/delete.
    // Both roles can view.
    // ------------------------------------------------------------

    match /vaccinations/{vaccinationId} {
      allow read: if isVeterinarian() || isStaff();

      allow create, update, delete: if isVeterinarian();
    }

    // ------------------------------------------------------------
    // FOLLOW-UPS
    // Veterinarians create/update/delete.
    // Both roles can view.
    // ------------------------------------------------------------

    match /followUps/{followUpId} {
      allow read: if isVeterinarian() || isStaff();

      allow create, update, delete: if isVeterinarian();
    }

    // ------------------------------------------------------------
    // APPOINTMENTS
    // Clinic staff schedule/manage appointments.
    // Both roles can view.
    // ------------------------------------------------------------

    match /appointments/{appointmentId} {
      allow read: if isVeterinarian() || isStaff();

      allow create, update, delete: if isStaff();
    }

    // ------------------------------------------------------------
    // CLINICS
    // Both roles can view.
    // Veterinarian can manage clinic records.
    // ------------------------------------------------------------

    match /clinics/{branchId} {
      allow read: if isVeterinarian() || isStaff();

      allow create, update: if isVeterinarian();

      allow delete: if false;
    }
  }
}