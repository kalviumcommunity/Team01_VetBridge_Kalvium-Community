rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────
    // Authentication helpers
    // ─────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isVeterinarian() {
      return isSignedIn()
          && get(
               /databases/$(database)/documents/users/$(request.auth.uid)
             ).data.role == 'veterinarian';
    }

    function isStaff() {
      return isSignedIn()
          && get(
               /databases/$(database)/documents/users/$(request.auth.uid)
             ).data.role == 'staff';
    }

    function isClinicUser() {
      return isVeterinarian() || isStaff();
    }


    // ─────────────────────────────────────────────
    // USERS
    // ─────────────────────────────────────────────

    match /users/{userId} {

      // A logged-in user can read their own profile.
      allow read: if isSignedIn()
                  && request.auth.uid == userId;

      // User profiles are managed through Firebase/Admin.
      allow write: if false;
    }


    // ─────────────────────────────────────────────
    // PETS
    // ─────────────────────────────────────────────

    match /pets/{petId} {

      // Both veterinarian and staff can search/view pets.
      allow read: if isClinicUser();

      // Staff registers and updates basic pet information.
      // Veterinarian can also create/update when needed.
      allow create, update: if isClinicUser();

      // Pets should not be deleted from the app.
      allow delete: if false;
    }


    // ─────────────────────────────────────────────
    // CLINICS
    // ─────────────────────────────────────────────

    match /clinics/{branchId} {

      // Both roles can see clinic/branch information.
      allow read: if isClinicUser();

      // Managed by administrator/Firebase Console.
      allow create, update, delete: if false;
    }


    // ─────────────────────────────────────────────
    // TREATMENTS
    // ─────────────────────────────────────────────

    match /treatments/{treatmentId} {

      // Both roles can view medical history.
      allow read: if isClinicUser();

      // Only veterinarian can create/update/delete treatments.
      allow create, update, delete: if isVeterinarian();
    }


    // ─────────────────────────────────────────────
    // VACCINATIONS
    // ─────────────────────────────────────────────

    match /vaccinations/{vaccinationId} {

      // Both roles can view vaccination history.
      allow read: if isClinicUser();

      // Only veterinarian can manage vaccinations.
      allow create, update, delete: if isVeterinarian();
    }


    // ─────────────────────────────────────────────
    // FOLLOW-UPS
    // ─────────────────────────────────────────────

    match /followUps/{followUpId} {

      // Both roles can view follow-ups.
      allow read: if isClinicUser();

      // Veterinarian creates and updates follow-ups.
      allow create, update, delete: if isVeterinarian();
    }


    // ─────────────────────────────────────────────
    // APPOINTMENTS
    // ─────────────────────────────────────────────

    match /appointments/{appointmentId} {

      // Both roles can view appointments.
      allow read: if isClinicUser();

      // Clinic staff schedules appointments.
      allow create, update, delete: if isStaff();
    }
  }
}